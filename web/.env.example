# Copie para .env.local (dev) ou configure no painel do host (Vercel, etc.)

# Obrigatórias — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da app (links em e-mail / convites). Na Vercel costuma ser opcional se usar VERCEL_URL.
NEXT_PUBLIC_APP_URL=

# Mercado Pago — PIX depósitos / mensalidades (produção)
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: true em sandbox de testes
MERCADOPAGO_TEST_MODE=

# Bling (OAuth + webhook) — se usar
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_WEBHOOK_SKIP_VERIFY=

# Admin — reset de senha org (se usar a rota)
ADMIN_RESET_SECRET=

# Dev / scripts org SKU (opcional)
DROPCORE_DEFAULT_ORG_ID=

# Trial portal (opcional; default no código se ausente)
PORTAL_TRIAL_DAYS=

# Meta Conversions API — landing pública (dataset "DropCore LP"), gerar em
# Gerenciador de Eventos > Configurações > Gerar token de acesso
META_CONVERSIONS_API_TOKEN=
